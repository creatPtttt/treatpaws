# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Wallet address allowed to open the hidden /admin console.
# Get it from `solana address` (CLI) or by copying your Phantom wallet's
# public key. Leave blank during local development to see the
# "admin not configured" notice instead of a hard Unauthorized screen.
VITE_ADMIN_PUBKEY=

# Dedicated Solana Devnet RPC endpoint (recommended: a free Helius Devnet
# key from https://dashboard.helius.dev). Falls back to the public
# `https://api.devnet.solana.com` when unset, which aggressively
# rate-limits (429s) batched calls like the Island Log drawer's activity
# fetch. The matching wss:// websocket endpoint is derived automatically
# from this same URL — no separate variable needed.
VITE_SOLANA_RPC_URL=
